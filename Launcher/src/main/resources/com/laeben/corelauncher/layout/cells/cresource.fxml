<?xml version="1.0" encoding="UTF-8"?>

<?import com.laeben.corelauncher.ui.control.CButton?>
<?import com.laeben.corelauncher.ui.control.CView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.text.Text?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER" spacing="16" fx:id="root" stylesheets="@../../style/cells/cresource.css">
    <CView fitWidth="72" fitHeight="72" fx:id="icon"/>
    <VBox spacing="4" HBox.hgrow="ALWAYS" maxWidth="Infinity">
        <VBox fillWidth="false">
            <HBox fx:id="header" spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="lblName"/>
                <Text text="•" style="-fx-fill: -text-fill; -fx-font-size: 20pt"/>
                <Label fx:id="lblAuthor"/>
            </HBox>
        </VBox>

        <TextFlow>
            <Text fx:id="txtDesc"/>
        </TextFlow>
    </VBox>
    <CButton fx:id="btnDelete" text="—" />
</HBox>
