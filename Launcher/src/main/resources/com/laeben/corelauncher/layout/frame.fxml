<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import com.laeben.corelauncher.ui.control.CButton?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.laeben.corelauncher.ui.controller.Frame"
            stylesheets="@../style/frame.css"
            fx:id="frameRoot"
            styleClass="frame-root"
            minWidth="200">
    <StackPane fx:id="content" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.bottomAnchor="0"/>
    <HBox AnchorPane.rightAnchor="4" AnchorPane.topAnchor="4" alignment="TOP_CENTER">
        <CButton styleClass="window-button" fx:id="btnMinimize"/>
        <CButton styleClass="window-button" fx:id="btnMaximize"/>
        <CButton styleClass="window-button" fx:id="btnClose"/>
    </HBox>
</AnchorPane>